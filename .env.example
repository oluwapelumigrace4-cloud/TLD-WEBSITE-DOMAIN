# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL COMMERCIAL DOMAIN PROVIDER API KEYS:
# By default, DotFootprint runs with the Authoritative Hybrid RDAP + DNS-over-HTTPS engine (free, no API key required).
# You can optionally configure commercial bulk providers:

# WhoisXML API: Used for bulk 1,000-domain availability checks and deep WHOIS records
# Get key at: https://whois.whoisxmlapi.com/
WHOISXML_API_KEY=""

# GoDaddy Developer API: Used for bulk domain availability (/v1/domains/available)
# Get key & secret at: https://developer.godaddy.com/keys
GODADDY_API_KEY=""
GODADDY_API_SECRET=""

